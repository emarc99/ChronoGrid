# AWS (uses your default credential chain; region must have Bedrock + Polly)
AWS_REGION=us-east-1

# Bedrock model used by the Alexa+ agent (Strands). Haiku keeps voice latency low.
CHRONOGRID_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional: upload clips to S3 and serve presigned URLs. Leave empty to serve clips locally.
CHRONOGRID_S3_BUCKET=

# Polly voice for the simulated Alexa+ speaker
CHRONOGRID_POLLY_VOICE=Joanna

# Server
CHRONOGRID_HOST=127.0.0.1
CHRONOGRID_PORT=8787
CHRONOGRID_DB=data/chronogrid.db

# Linter heartbeat in seconds (30 in production, lower for demos)
CHRONOGRID_LINT_INTERVAL=5
